{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "research/benchmarks/**/*.ts",
    "scripts/**/*.d.mts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
