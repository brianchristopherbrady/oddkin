{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/components/test/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.examples.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "research/benchmarks/**/*.ts",
    "research/experiments/**/*.ts",
    "scripts/**/*.d.mts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  // Each consumer, and each golden-path project, type-checks in its own fresh project, against
  // the packed packages.
  "exclude": ["tests/consumers", "tests/golden-path"]
}
