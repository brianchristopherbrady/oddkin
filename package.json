{
  "name": "oddkin-workspace",
  "private": true,
  "type": "module",
  "description": "Oddkin: a modular Web Component framework, design system, token pipeline, and documentation tooling.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-token-assets.mjs && node scripts/build-production.mjs && node scripts/build-component-css.mjs && node scripts/build-metadata.mjs && node scripts/build-component-schemas.mjs && node scripts/build-ai-schemas.mjs && node scripts/build-ai-demos.mjs",
    "contracts": "node scripts/build-contracts.mjs",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p tsconfig.jsx.json && node scripts/check-framework-types.mjs",
    "lint": "npm run lint:contracts && npm run lint:boundaries && npm run lint:css && npm run format:check",
    "lint:contracts": "node scripts/build-contracts.mjs --check",
    "lint:boundaries": "npm run build && node scripts/architecture/check-boundaries.mjs --artifacts",
    "lint:css": "node scripts/compat/check-css.mjs",
    "compat": "node scripts/compat/check-css.mjs --write",
    "compat:floor": "node scripts/compat/floor-browsers.mjs && node scripts/compat/run-floor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "test:e2e": "playwright test",
    "verify:packs": "node scripts/verify-packs.mjs && node apps/docs/snippets/verify.mjs",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "dev": "tsc -b apps/docs && node apps/docs/dev.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run verify:metadata && npm run size && npm run test:e2e && npm run verify:packs",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@mdn/browser-compat-data": "8.1.6",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "4.14.0",
    "css-tree": "3.2.1",
    "custom-element-vs-code-integration": "1.5.0",
    "custom-elements-manifest": "2.1.0",
    "es-module-lexer": "^3.0.4",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "web-features": "3.43.0"
  }
}
