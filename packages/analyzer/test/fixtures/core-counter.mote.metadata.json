{
  "schema": "https://mote.dev/schemas/mote-metadata/v1.json",
  "moteVersion": "0.0.0",
  "library": {
    "name": "core-counter",
    "version": "0.0.0",
    "packages": [
      {
        "name": "core-counter",
        "version": "0.0.0",
        "customElements": "./custom-elements.json"
      }
    ]
  },
  "components": {
    "component:demo-counter": {
      "tag": "demo-counter",
      "cem": {
        "module": "dist/demo-counter/demo-counter.js",
        "name": "DemoCounter"
      },
      "registration": "dist/demo-counter/demo-counter.define.js",
      "definition": {
        "ref": {
          "module": "dist/demo-counter/demo-counter.definition.js",
          "name": "demoCounterDefinition"
        },
        "template": {
          "module": "dist/demo-counter/demo-counter.template.js",
          "name": "demoCounterTemplate"
        },
        "styles": [
          {
            "module": "dist/demo-counter/demo-counter.styles.js",
            "name": "demoCounterStyles"
          }
        ]
      },
      "syncPairs": [
        {
          "property": "count",
          "event": "count-change"
        }
      ]
    },
    "component:demo-greeting": {
      "tag": "demo-greeting",
      "cem": {
        "module": "dist/demo-greeting/demo-greeting.js",
        "name": "DemoGreeting"
      },
      "registration": "dist/demo-greeting/demo-greeting.define.js",
      "definition": {
        "ref": {
          "module": "dist/demo-greeting/demo-greeting.definition.js",
          "name": "demoGreetingDefinition"
        },
        "template": {
          "module": "dist/demo-greeting/demo-greeting.template.js",
          "name": "demoGreetingTemplate"
        },
        "styles": [
          {
            "module": "dist/demo-greeting/demo-greeting.styles.js",
            "name": "demoGreetingStyles"
          }
        ]
      }
    }
  },
  "diagnostics": []
}
