{
  "name": "@oddkin/analyzer",
  "version": "1.0.0-beta.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianchristopherbrady/oddkin.git",
    "directory": "packages/analyzer"
  },
  "homepage": "https://www.oddkin.dev",
  "bugs": {
    "url": "https://github.com/brianchristopherbrady/oddkin/issues"
  },
  "description": "Node-only static analysis of Oddkin component libraries: Custom Elements Manifest and oddkin.metadata.json, without executing component code, and the agent kits generated from them.",
  "keywords": [
    "oddkin",
    "custom-elements-manifest",
    "static-analysis",
    "web-components",
    "agent-kit"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "oddkin-analyze": "dist/bin.js",
    "oddkin-impact": "dist/impact-bin.js",
    "oddkin-kit": "dist/kit-bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./impact": {
      "types": "./dist/impact.d.ts",
      "default": "./dist/impact.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "default": "./dist/composition.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "dependencies": {
    "@oddkin/core": "^1.0.0-beta.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
