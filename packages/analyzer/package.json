{
  "name": "@oddkin/analyzer",
  "version": "0.0.0",
  "private": true,
  "description": "Node-only static analysis of Oddkin component libraries: Custom Elements Manifest and oddkin.metadata.json, without executing component code.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "oddkin-analyze": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./impact": {
      "types": "./dist/impact.d.ts",
      "default": "./dist/impact.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "typescript": "5.9.3"
  }
}
