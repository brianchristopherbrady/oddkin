{
  "name": "@oddkin/app",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianchristopherbrady/oddkin.git",
    "directory": "packages/app"
  },
  "description": "Optional application lifetime, router, and async resources.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "default": "./dist/prod/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "development": "./dist/app/index.js",
      "default": "./dist/prod/app/index.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "development": "./dist/resource/index.js",
      "default": "./dist/prod/resource/index.js"
    },
    "./command": {
      "types": "./dist/command/index.d.ts",
      "development": "./dist/command/index.js",
      "default": "./dist/prod/command/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "development": "./dist/router/index.js",
      "default": "./dist/prod/router/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "development": "./dist/lifecycle/index.js",
      "default": "./dist/prod/lifecycle/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@oddkin/core": "0.0.0",
    "@oddkin/state": "0.0.0"
  }
}
