{
  "name": "@mote/workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Metadata-driven documentation tooling. DOM-free example, configuration, page-registry, and conformance contracts; a test-runner integration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "default": "./dist/examples/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "default": "./dist/pages/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./conformance/button": {
      "types": "./dist/conformance/button.d.ts",
      "default": "./dist/conformance/button.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@mote/core": "0.0.0"
  }
}
