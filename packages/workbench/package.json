{
  "name": "@oddkin/workbench",
  "version": "1.0.0-beta.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianchristopherbrady/oddkin.git",
    "directory": "packages/workbench"
  },
  "description": "Metadata-driven documentation tooling. DOM-free example, configuration, page-registry, data-file, and conformance contracts; a test-runner integration.",
  "type": "module",
  "sideEffects": [
    "./dist/app/define.js",
    "./dist/frame/index.js",
    "./dist/panels/component-define.js",
    "./dist/panels/foundation-define.js",
    "./dist/panels/catalog-define.js"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "oddkin": "dist/node/bin.js"
  },
  "exports": {
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "default": "./dist/examples/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "default": "./dist/pages/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./app/define": {
      "types": "./dist/app/define.d.ts",
      "default": "./dist/app/define.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./conformance/button": {
      "types": "./dist/conformance/button.d.ts",
      "default": "./dist/conformance/button.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./frame": {
      "types": "./dist/frame/index.d.ts",
      "default": "./dist/frame/index.js"
    },
    "./panels/component": {
      "types": "./dist/panels/component.d.ts",
      "default": "./dist/panels/component.js"
    },
    "./panels/component/define": {
      "types": "./dist/panels/component-define.d.ts",
      "default": "./dist/panels/component-define.js"
    },
    "./panels/foundation": {
      "types": "./dist/panels/foundation.d.ts",
      "default": "./dist/panels/foundation.js"
    },
    "./panels/foundation/define": {
      "types": "./dist/panels/foundation-define.d.ts",
      "default": "./dist/panels/foundation-define.js"
    },
    "./panels/catalog": {
      "types": "./dist/panels/catalog.d.ts",
      "default": "./dist/panels/catalog.js"
    },
    "./panels/catalog/define": {
      "types": "./dist/panels/catalog-define.d.ts",
      "default": "./dist/panels/catalog-define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@oddkin/analyzer": "^1.0.0-beta.1",
    "@oddkin/app": "^1.0.0-beta.1",
    "@oddkin/components": "^1.0.0-beta.1",
    "@oddkin/core": "^1.0.0-beta.1",
    "@oddkin/state": "^1.0.0-beta.1",
    "@oddkin/tokens": "^1.0.0-beta.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
