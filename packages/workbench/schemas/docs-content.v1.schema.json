{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/docs-content/v1.json",
  "title": "Authored Workbench content v1",
  "description": "DRAFT. JSON-compatible shape of defineDocs (oddkin.docs.ts) and Markdown front matter. Overrides prose and presentation only; generated facts stay authoritative (ADR 0024). Use {{fact.path}} tokens to reference generated values.",
  "type": "object",
  "required": ["schema", "pages"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://oddkin.dev/schemas/docs-content/v1.json" },
    "locale": { "type": "string" },
    "aliases": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Renamed page/section id -> current id (migration)" },
    "pages": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "eyebrow": { "type": "string" },
          "summary": { "type": "string" },
          "intro": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "updated": { "type": "string", "format": "date" },
          "order": { "type": "integer" },
          "visible": { "type": "boolean" },
          "useFor": { "type": "array", "items": { "type": "string" } },
          "notFor": { "type": "array", "items": { "type": "string" } },
          "sections": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z0-9-]+$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "title": { "type": "string" }, "guidance": { "type": "string" }, "visible": { "type": "boolean" }, "order": { "type": "integer" }, "examples": { "type": "array", "items": { "type": "string", "pattern": "^example:" } } }
            }
          }
        }
      }
    }
  }
}