{
  "name": "@oddkin/tokens",
  "version": "1.0.0-beta.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianchristopherbrady/oddkin.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://www.oddkin.dev",
  "bugs": {
    "url": "https://github.com/brianchristopherbrady/oddkin/issues"
  },
  "description": "Theme configuration, pure token generation, and CSS, JSON, DTCG, and TypeScript outputs. Browser entry points are DOM-free.",
  "keywords": [
    "oddkin",
    "design-tokens",
    "theme",
    "css-custom-properties",
    "dtcg"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./refs": {
      "types": "./dist/refs/index.d.ts",
      "default": "./dist/refs/index.js"
    },
    "./values": {
      "types": "./dist/values/index.d.ts",
      "default": "./dist/values/index.js"
    },
    "./conditions": {
      "types": "./dist/conditions/index.d.ts",
      "default": "./dist/conditions/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./css/default.css": "./dist/css/default.css",
    "./scss/refs": "./dist/scss/refs.scss",
    "./scss/values": "./dist/scss/values.scss",
    "./inspect/default.json": "./dist/inspect/default.inspect.json",
    "./inspect/default.contrast.json": "./dist/inspect/default.contrast.json",
    "./schema.json": "./schema/theme-config.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "bin": {
    "oddkin-tokens": "dist/node/bin.js"
  },
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
