{
  "name": "@mote/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Theme configuration, pure token generation, and CSS/SCSS/JSON/TS outputs. Browser entry points are DOM-free.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "default": "./dist/generate/index.js"
    },
    "./schema.json": "./schema/theme-config.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ]
}
