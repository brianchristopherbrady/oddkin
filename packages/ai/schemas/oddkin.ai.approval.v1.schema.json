{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/ai/oddkin.ai.approval.v1.schema.json",
  "title": "oddkin.ai.approval",
  "description": "A request to approve an action. Approval never implies the action succeeded.",
  "type": "object",
  "properties": {
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "toolCallId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "description": "Proposal revision.",
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "target": {
      "description": "What the action affects.",
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "requested",
        "decision-pending",
        "approved",
        "rejected",
        "expired",
        "superseded",
        "decision-failed"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reason": {
      "type": "string"
    },
    "expiresAt": {
      "description": "ISO 8601 timestamp.",
      "type": "string"
    },
    "error": {
      "description": "An error safe to show to users. Diagnostic details stay in host logs.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable application-defined code.",
          "type": "string",
          "minLength": 1
        },
        "message": {
          "description": "User-presentable message, localized by the host.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether retrying the same operation may succeed.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "approvalId",
    "revision",
    "title",
    "status"
  ]
}
