{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/ai/oddkin.ai.suggestion.v1.schema.json",
  "title": "oddkin.ai.suggestion",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prompt": {
      "description": "Text inserted or submitted.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "prompt"
  ]
}
