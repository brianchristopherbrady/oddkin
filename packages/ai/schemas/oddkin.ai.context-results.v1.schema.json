{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/ai/oddkin.ai.context-results.v1.schema.json",
  "title": "oddkin.ai.context-results",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "description": "A resource a person can add as context. Identity is `sourceId` with `id`.",
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "description": "Untrusted; rendered as text.",
            "type": "string",
            "minLength": 1
          },
          "type": {
            "description": "What it is, in the host’s words: document, page, account.",
            "type": "string",
            "minLength": 1
          },
          "path": {
            "description": "Where it is, e.g. \"Product / Launch\".",
            "type": "string"
          },
          "description": {
            "description": "Useful metadata, e.g. \"2h ago\".",
            "type": "string"
          },
          "unavailable": {
            "description": "Why it cannot be used now; absent when it can.",
            "type": "string"
          },
          "container": {
            "description": "Opens to show what is inside it when activated; it is not chosen itself.",
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "id",
          "label",
          "type"
        ]
      }
    },
    "sources": {
      "description": "Each searched source; a failed source is never shown as no matches.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "failed"
            ]
          },
          "error": {
            "description": "An error safe to show to users. Diagnostic details stay in host logs.",
            "type": "object",
            "properties": {
              "code": {
                "description": "Stable application-defined code.",
                "type": "string",
                "minLength": 1
              },
              "message": {
                "description": "User-presentable message, localized by the host.",
                "type": "string"
              },
              "retryable": {
                "description": "Whether retrying the same operation may succeed.",
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "sourceId",
          "status"
        ]
      }
    },
    "total": {
      "description": "All matches, if the host knows.",
      "type": "integer",
      "minimum": 0
    },
    "nextCursor": {
      "description": "Give it back in `cursor` to ask for the next page.",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "items"
  ]
}
