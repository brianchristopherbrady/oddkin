{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-picker.v1.json",
  "title": "odd-picker",
  "description": "A field that opens a list or a hierarchy to choose from (APG select-only combobox): a popup listbox of options, or, with `items`, a popup tree whose rows expand and collapse without selecting. Single: activating a row chooses it and closes. Multiple: rows toggle at once, the chosen values are chips in the field (\"+N\" for those that do not fit), and Done closes. Options come from `<option>` and `<optgroup>` children, written as for a native select, or from `options`; a hierarchy comes from `items`.",
  "$comment": "Slots: \"empty\", \"status\". A child names a slot with \"slot\"; text and children without \"slot\" go to the default slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-picker"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Name submitted with the form. Reflected: a form-associated element submits under its name attribute."
        },
        "disabled": {
          "type": "boolean",
          "description": "Prevents interaction and submission.",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Help text below the label.",
          "default": ""
        },
        "error": {
          "type": "string",
          "description": "Error message; marks the field invalid (custom validity) while set.",
          "default": ""
        },
        "label": {
          "type": "string",
          "description": "Visible label; names the control.",
          "default": ""
        },
        "value": {
          "type": "string",
          "description": "Value of the selected option; the `value` attribute sets the default.",
          "default": ""
        },
        "multiple": {
          "type": "boolean",
          "description": "Several options can be selected.",
          "default": false
        },
        "required": {
          "type": "boolean",
          "description": "An option must be selected to submit.",
          "default": false
        },
        "loading": {
          "type": "boolean",
          "description": "Shows a busy row and marks the options busy.",
          "default": false
        },
        "placeholder": {
          "type": "string",
          "description": "Text shown while nothing is chosen.",
          "default": ""
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Values of the selected options with `multiple`."
        },
        "expanded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of expanded items with `items`, owned by the caller. Omit it to let the element track expansion."
        },
        "strings": {
          "type": "object",
          "properties": {
            "loading": {
              "type": "string"
            },
            "empty": {
              "type": "string"
            },
            "clear": {
              "type": "string"
            },
            "remove": {
              "type": "string"
            },
            "selected": {
              "type": "string"
            },
            "more": {
              "type": "string"
            },
            "hint": {
              "type": "string"
            },
            "count": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "done": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "description": "Localized string overrides; `remove` takes `{label}`, `more` and `count` take `{count}`, `path` takes `{parent}` and `{label}`."
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/node"
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        },
        "input": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        },
        "odd-toggle": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        }
      }
    }
  }
}
