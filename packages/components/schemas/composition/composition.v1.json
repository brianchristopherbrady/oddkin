    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][\\w-]*$",
      "description": "The element's id, unique in the document."
    },
    "slot": {
      "type": "string",
      "minLength": 1,
      "description": "A named slot of the parent element."
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*(?:\\.[a-zA-Z0-9-]+)*$",
      "description": "An action name the host handles, such as \"settings.save\"; never code."
    },
    "native-p": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element"
      ],
      "properties": {
        "element": {
          "const": "p"
        },
        "id": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
        },
        "slot": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
        },
