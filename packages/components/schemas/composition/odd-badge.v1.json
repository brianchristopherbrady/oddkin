{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-badge.v1.json",
  "title": "odd-badge",
  "description": "A passive status or count: words with a tone colour and a glyph, so the meaning never rests on colour alone. Not an action; do not make it clickable.",
  "$comment": "Slots: default. A child names a slot with \"slot\"; text and children without \"slot\" go to the default slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-badge"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ],
          "description": "Meaning colour and glyph.",
          "default": "neutral"
        },
        "no-marker": {
          "type": "boolean",
          "description": "Hides the tone glyph, as for a count.",
          "default": false
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/node"
      }
    }
  }
}
