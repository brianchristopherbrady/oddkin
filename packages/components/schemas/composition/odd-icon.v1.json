{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-icon.v1.json",
  "title": "odd-icon",
  "description": "An icon drawn in the current text colour: an SVG file by URL (`src`), or an inline `<svg>` placed inside. Oddkin ships no icon set; bring your own, and pay only for the icons you use.",
  "$comment": "Slots: default. A child names a slot with \"slot\"; text and children without \"slot\" go to the default slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-icon"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^(?![\\u0000-\\u0020]*(?:[jJ]\\s*[aA]\\s*[vV]\\s*[aA]\\s*[sS]\\s*[cC]\\s*[rR]\\s*[iI]\\s*[pP]\\s*[tT]|[vV]\\s*[bB]\\s*[sS]\\s*[cC]\\s*[rR]\\s*[iI]\\s*[pP]\\s*[tT])\\s*:)",
          "description": "URL of an SVG, drawn in the current text colour; empty uses the slotted `<svg>`.",
          "default": ""
        },
        "label": {
          "type": "string",
          "description": "Accessible name; empty marks the icon decorative.",
          "default": ""
        },
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ],
          "description": "Edge length: 16, 20, or 24 px (the icon size tokens).",
          "default": "md"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/node"
      }
    }
  }
}
