{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-segmented-control.v1.json",
  "title": "odd-segmented-control",
  "description": "One value from a few short options, drawn as joined segments: the radio-group behavior with a segmented look. Options come from `<option>` children or from `options`; an option with an `icon` (`options` only) shows the icon alone, and its `label` names it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-segmented-control"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Name submitted with the form. Reflected: a form-associated element submits under its name attribute."
        },
        "disabled": {
          "type": "boolean",
          "description": "Prevents interaction and submission.",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Help text below the label.",
          "default": ""
        },
        "error": {
          "type": "string",
          "description": "Error message; marks the field invalid (custom validity) while set.",
          "default": ""
        },
        "label": {
          "type": "string",
          "description": "Visible label; names the group.",
          "default": ""
        },
        "value": {
          "type": "string",
          "description": "Value of the checked option; the `value` attribute sets the default.",
          "default": ""
        },
        "required": {
          "type": "boolean",
          "description": "An option must be checked to submit.",
          "default": false
        },
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ],
          "description": "Segment height and padding.",
          "default": "md"
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        },
        "input": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        }
      }
    }
  }
}
