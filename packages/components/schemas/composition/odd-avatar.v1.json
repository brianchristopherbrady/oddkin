{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-avatar.v1.json",
  "title": "odd-avatar",
  "description": "A person or group marker: a picture (`src`) or, without one or when it fails to load, the initials of `label`. Content placed inside replaces the initials (a \"+3\" overflow count).",
  "$comment": "Slots: default. A child names a slot with \"slot\"; text and children without \"slot\" go to the default slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-avatar"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "The person's or group's name; names the image.",
          "default": ""
        },
        "src": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^(?![\\u0000-\\u0020]*(?:[jJ]\\s*[aA]\\s*[vV]\\s*[aA]\\s*[sS]\\s*[cC]\\s*[rR]\\s*[iI]\\s*[pP]\\s*[tT]|[vV]\\s*[bB]\\s*[sS]\\s*[cC]\\s*[rR]\\s*[iI]\\s*[pP]\\s*[tT])\\s*:)",
          "description": "Picture URL; the initials show without it.",
          "default": ""
        },
        "size": {
          "enum": [
            "sm",
            "md",
            "lg"
          ],
          "description": "Diameter: 32, 40, or 48 px.",
          "default": "md"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/node"
      }
    }
  }
}
