{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-empty-state.v1.json",
  "title": "odd-empty-state",
  "description": "Explains why a region is empty and offers the next useful step: first use, no results, nothing left to do.",
  "$comment": "Slots: default, \"footer\", \"media\". A child names a slot with \"slot\"; text and children without \"slot\" go to the default slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-empty-state"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "The title.",
          "default": ""
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/node"
      }
    }
  }
}
