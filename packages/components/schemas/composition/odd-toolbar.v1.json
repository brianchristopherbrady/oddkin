{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-toolbar.v1.json",
  "title": "odd-toolbar",
  "description": "A named group of controls with one Tab stop (APG toolbar): arrow keys move focus among the slotted controls, which stay the author's own elements. An `<hr>` child is drawn as a separator.",
  "$comment": "Slots: default. A child names a slot with \"slot\"; text and children without \"slot\" go to the default slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-toolbar"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Names the toolbar.",
          "default": ""
        },
        "orientation": {
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "Controls in a row or a column; sets the arrow keys that move between them.",
          "default": "horizontal"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/node"
      }
    }
  }
}
