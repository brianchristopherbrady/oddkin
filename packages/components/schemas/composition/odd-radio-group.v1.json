{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/composition/odd-radio-group.v1.json",
  "title": "odd-radio-group",
  "description": "One value from a short set of visible options, each a native radio with its label and description. Options come from `<option>` and `<optgroup>` children, written as for a native select (`selected` marks the default, `title` is the description), or from `options`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "const": "odd-radio-group"
    },
    "id": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/id"
    },
    "slot": {
      "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/slot"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Name submitted with the form. Reflected: a form-associated element submits under its name attribute."
        },
        "disabled": {
          "type": "boolean",
          "description": "Prevents interaction and submission.",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Help text below the label.",
          "default": ""
        },
        "error": {
          "type": "string",
          "description": "Error message; marks the field invalid (custom validity) while set.",
          "default": ""
        },
        "label": {
          "type": "string",
          "description": "Visible label; names the group.",
          "default": ""
        },
        "value": {
          "type": "string",
          "description": "Value of the checked option; the `value` attribute sets the default.",
          "default": ""
        },
        "required": {
          "type": "boolean",
          "description": "An option must be checked to submit.",
          "default": false
        },
        "orientation": {
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "Stacks the options, or lines them up and wraps them.",
          "default": "vertical"
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        },
        "input": {
          "$ref": "https://oddkin.dev/schemas/composition/composition.v1.json#/$defs/action"
        }
      }
    }
  }
}
