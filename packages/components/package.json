{
  "name": "@oddkin/components",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, themed custom elements, Oddkin layout presets, and component metadata.",
  "type": "module",
  "sideEffects": [
    "./dist/**/*.define.js"
  ],
  "customElements": "./custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./button/foundation": {
      "types": "./dist/button/foundation.d.ts",
      "default": "./dist/button/foundation.js"
    },
    "./define/button": {
      "types": "./dist/button/button.define.d.ts",
      "default": "./dist/button/button.define.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "default": "./dist/card/index.js"
    },
    "./card/foundation": {
      "types": "./dist/card/foundation.d.ts",
      "default": "./dist/card/foundation.js"
    },
    "./define/card": {
      "types": "./dist/card/card.define.d.ts",
      "default": "./dist/card/card.define.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./input/foundation": {
      "types": "./dist/input/foundation.d.ts",
      "default": "./dist/input/foundation.js"
    },
    "./define/input": {
      "types": "./dist/input/input.define.d.ts",
      "default": "./dist/input/input.define.js"
    },
    "./side-nav": {
      "types": "./dist/side-nav/index.d.ts",
      "default": "./dist/side-nav/index.js"
    },
    "./side-nav/foundation": {
      "types": "./dist/side-nav/foundation.d.ts",
      "default": "./dist/side-nav/foundation.js"
    },
    "./side-nav/recipe": {
      "types": "./dist/side-nav/side-nav.recipe.d.ts",
      "default": "./dist/side-nav/side-nav.recipe.js"
    },
    "./define/side-nav": {
      "types": "./dist/side-nav/side-nav.define.d.ts",
      "default": "./dist/side-nav/side-nav.define.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./css/reset.css": "./dist/css/reset.css",
    "./css/base.css": "./dist/css/base.css",
    "./css/layout.css": "./dist/css/layout.css",
    "./css/utilities.css": "./dist/css/utilities.css",
    "./custom-elements.json": "./custom-elements.json",
    "./oddkin.metadata.json": "./oddkin.metadata.json",
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "custom-elements.json",
    "oddkin.metadata.json",
    "README.md"
  ],
  "dependencies": {
    "@oddkin/core": "0.0.0",
    "@oddkin/tokens": "0.0.0"
  },
  "devDependencies": {
    "@oddkin/workbench": "0.0.0"
  }
}
