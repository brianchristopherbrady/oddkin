{
  "name": "@mote/components",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, themed custom elements, Mote layout presets, and component metadata.",
  "type": "module",
  "sideEffects": [
    "./dist/**/*.define.js"
  ],
  "customElements": "./custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./button/foundation": {
      "types": "./dist/button/foundation.d.ts",
      "default": "./dist/button/foundation.js"
    },
    "./define/button": {
      "types": "./dist/button/button.define.d.ts",
      "default": "./dist/button/button.define.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "default": "./dist/card/index.js"
    },
    "./card/foundation": {
      "types": "./dist/card/foundation.d.ts",
      "default": "./dist/card/foundation.js"
    },
    "./define/card": {
      "types": "./dist/card/card.define.d.ts",
      "default": "./dist/card/card.define.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./mote.metadata.json": "./mote.metadata.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "mote.metadata.json",
    "README.md"
  ],
  "dependencies": {
    "@mote/core": "0.0.0",
    "@mote/tokens": "0.0.0"
  }
}
