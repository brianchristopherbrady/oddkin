{
  "name": "@oddkin/state",
  "version": "1.0.0-beta.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianchristopherbrady/oddkin.git",
    "directory": "packages/state"
  },
  "description": "Optional stores, selectors, context, persistence, and inspection.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "default": "./dist/prod/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "development": "./dist/store/index.js",
      "default": "./dist/prod/store/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "development": "./dist/context/index.js",
      "default": "./dist/prod/context/index.js"
    },
    "./inspect": {
      "types": "./dist/inspect/index.d.ts",
      "development": "./dist/inspect/index.js",
      "default": "./dist/prod/inspect/index.js"
    },
    "./persist": {
      "types": "./dist/persist/index.d.ts",
      "development": "./dist/persist/index.js",
      "default": "./dist/prod/persist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@oddkin/core": "^1.0.0-beta.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
