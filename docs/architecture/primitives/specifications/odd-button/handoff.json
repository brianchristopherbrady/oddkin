  "deltas": [
    {
      "id": "B-D4",
      "from": "Ordinary text geometry even when the only content was an icon.",
      "to": "Infer native intrinsic square presentation from one default-slot icon and provide data-icon-only for the native recipe.",
      "rationale": "Avoid a new element and express the existing control and target tokens.",
      "evidence": [
        "docs/architecture/primitives/specifications/odd-button/decision.md",
        "docs/architecture/primitives/specifications/odd-button/figma-evidence.json"
      ]
    },
    {
      "id": "B-D5",
      "from": "Slotted icons used their own size defaults.",
      "to": "Inherit Button’s context-specific icon sizing, with a per-icon style override.",
      "rationale": "Reuse the icon size tokens and shared glyph artwork.",
      "evidence": [
        "docs/architecture/primitives/specifications/odd-button/decision.md",
        "docs/architecture/primitives/specifications/odd-button/figma-evidence.json"
      ]
    },
    {
      "id": "B-D6",
      "from": "There was no Button-specific naming diagnostic.",
      "to": "Log a warning once for a missing own label on an icon-only Button.",
      "rationale": "A glyph alone does not communicate the intended action.",
      "evidence": [
        "docs/architecture/primitives/specifications/odd-button/decision.md",
        "docs/architecture/primitives/specifications/odd-button/figma-evidence.json"
      ]
    },
    {
      "id": "B-D7",
      "from": "Native recipe hover rules did not match links.",
      "to": "Allow the native recipe on links, including intended hover and disabled styling.",
      "rationale": "Keep native navigation semantics and one shared visual recipe.",
      "evidence": [
        "docs/architecture/primitives/specifications/odd-button/decision.md",
        "docs/architecture/primitives/specifications/odd-button/figma-evidence.json"
      ]
    },
    {
      "id": "B-D8",
      "from": "Calendar and Carousel duplicated square styles.",
      "to": "Reuse native icon-only styling with their existing size and artwork.",
      "rationale": "Preserve consumer geometry through a shared definition.",
      "evidence": [
        "docs/architecture/primitives/specifications/odd-button/decision.md",
        "docs/architecture/primitives/specifications/odd-button/figma-evidence.json"
      ]
    },
    {
      "id": "B-D9",
      "from": "Trailing icon had no canonical swap in the text component sets and states review cropped focus.",
      "to": "Keep trailing content optional with chevron as the Figma default, and reserve focus-ring space in the verification rows.",
      "rationale": "Keep the component-set identities and reveal the already implemented focus geometry.",
      "evidence": [
        "docs/architecture/primitives/specifications/odd-button/decision.md",
        "docs/architecture/primitives/specifications/odd-button/figma-evidence.json"
      ]
    }
  ],
