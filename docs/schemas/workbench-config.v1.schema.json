{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mote.dev/schemas/workbench-config/v1.json",
  "title": "Workbench configuration (mote.config) v1",
  "description": "DRAFT. JSON-compatible shape of defineWorkbenchConfig (workbench.md, workbench-pages.md).",
  "type": "object",
  "required": ["library"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "library": {
      "type": "object",
      "required": ["packages"],
      "additionalProperties": false,
      "properties": {
        "packages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cem": { "type": "array", "items": { "type": "string" }, "description": "Explicit standard CEM inputs for libraries without Mote enrichment" }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "logo": { "type": "string" }, "theme": { "type": "string" }, "links": { "type": "array", "items": { "type": "object", "required": ["label", "href"], "properties": { "label": { "type": "string" }, "href": { "type": "string" } } } } }
    },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "basePath": { "type": "string", "default": "/" }, "routing": { "enum": ["history", "hash"], "default": "history" } }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": { "type": "boolean", "default": false },
        "primary": { "type": "array", "items": { "type": "string" }, "description": "Ordered section ids; defaults to foundations, components, theme-studio" },
        "legacyRedirects": { "type": "boolean", "default": true }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definitions": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "description": { "type": "string" }, "order": { "type": "integer" } } } },
        "assign": { "type": "object", "additionalProperties": { "type": "string" }, "description": "tag -> category id overrides" },
        "fallback": { "type": "string", "default": "Other components" }
      }
    },
    "themeStudio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "route": { "type": "string", "default": "/theme-studio" },
        "themeConfig": { "type": "string" },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": { "type": "string", "default": "theme-specimen" },
            "roles": { "type": "object", "additionalProperties": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["component"], "additionalProperties": false, "properties": { "component": { "type": "string" }, "example": { "type": "string" }, "adapter": { "type": "string" } } } ] } }
          }
        }
      }
    },
    "products": { "$ref": "#/$defs/products" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "files": { "type": "array", "items": { "type": "string" } }, "locales": { "type": "array", "items": { "type": "string" } }, "defaultLocale": { "type": "string" } }
    },
    "assets": { "type": "array", "items": { "type": "string" }, "description": "Stylesheets, fonts, and files loaded into preview frames" }
  },
  "$defs": {
    "products": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "placement": { "type": "array", "items": { "enum": ["foundations", "primary"] }, "default": ["foundations"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "from": {
                "oneOf": [
                  { "type": "object", "required": ["theme", "product"], "additionalProperties": false, "properties": { "theme": { "type": "string" }, "product": { "type": "string" } } },
                  { "type": "object", "required": ["package"], "additionalProperties": false, "properties": { "package": { "type": "string" }, "export": { "type": "string" } } },
                  { "type": "object", "required": ["manifest", "version"], "additionalProperties": false, "properties": { "manifest": { "type": "string" }, "version": { "type": "string" } } }
                ]
              }
            }
          }
        },
        "discovery": { "type": "object", "additionalProperties": false, "properties": { "workspace": { "type": "boolean", "default": false }, "exclude": { "type": "array", "items": { "type": "string" } } } }
      }
    }
  }
}