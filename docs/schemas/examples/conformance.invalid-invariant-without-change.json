{
  "schema": "https://oddkin.dev/schemas/conformance/v1.json",
  "id": "oddkin.button",
  "version": "0.1.0",
  "contract": {
    "component": "component:odd-button",
    "versions": "0.x"
  },
  "description": "Interaction contract shared by odd-button and its product implementations.",
  "requires": {
    "properties": [
      "appearance",
      "size",
      "type",
      "disabled",
      "loading",
      "fullWidth",
      "name",
      "value",
      "label"
    ],
    "events": [
      "click"
    ],
    "slots": [
      "",
      "start",
      "end"
    ],
    "anatomy": [
      "control"
    ]
  },
  "cases": [
    {
      "id": "reconnect",
      "title": "Invariant without its declared change",
      "kind": "invariant"
    }
  ]
}
