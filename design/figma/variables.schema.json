{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddkin.dev/schemas/figma-variables/v1.json",
  "title": "Oddkin Figma variables snapshot v1",
  "description": "design/figma/variables.json: a read-only export of a Figma file's local variables, text styles, and effect styles (design/figma/variables.export.js). Tests read this file and never call Figma. Collections and variables are sorted by name; valuesByMode keys are mode names; colours are lower-case hex; numbers are Figma's stored values (px for dimensions). The mapping to --odd-* tokens lives in the parity test, not here.",
  "type": "object",
  "required": [
    "$schema",
    "fileKey",
    "fileName",
    "exportedAt",
    "source",
    "collections",
    "textStyles",
    "effectStyles"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./variables.schema.json" },
    "fileKey": { "type": "string", "pattern": "^[0-9A-Za-z]{22,128}$" },
    "fileName": {
      "type": "string",
      "description": "figma.root.name as the Plugin API reports it: \"Document\" for this file, whose title in Figma is \"Oddkin - Design Framework\"."
    },
    "version": {
      "type": "string",
      "description": "File version, when the export tool reports one."
    },
    "lastModified": {
      "type": "string",
      "description": "Last modification time, when the export tool reports one."
    },
    "exportedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The tool, session, and API calls used for the export."
    },
    "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } },
    "textStyles": { "type": "array", "items": { "$ref": "#/$defs/textStyle" } },
    "effectStyles": { "type": "array", "items": { "$ref": "#/$defs/effectStyle" } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}([0-9a-f]{2})?$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "<collection name>/<variable name> of a variable."
    },
    "collection": {
      "type": "object",
      "required": ["id", "name", "modes", "defaultModeId", "variables"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
          }
        },
        "defaultModeId": { "type": "string" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } }
      }
    },
    "variable": {
      "type": "object",
      "required": ["id", "name", "type", "scopes", "valuesByMode"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN"] },
        "description": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "codeSyntax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "WEB": { "type": "string" },
            "ANDROID": { "type": "string" },
            "iOS": { "type": "string" }
          }
        },
        "hiddenFromPublishing": { "const": true },
        "valuesByMode": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": ["value"],
                "additionalProperties": false,
                "properties": {
                  "value": { "type": ["string", "number", "boolean"] },
                  "alpha": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Unquantized color alpha; the hex value alone rounds alpha to 8 bits."
                  }
                }
              },
              {
                "type": "object",
                "required": ["alias"],
                "additionalProperties": false,
                "properties": { "alias": { "$ref": "#/$defs/path" } }
              }
            ]
          }
        }
      }
    },
    "unitValue": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": { "enum": ["PIXELS", "PERCENT", "AUTO"] },
        "value": { "type": "number" }
      }
    },
    "bound": {
      "type": "object",
      "description": "Bound variables by field: one path, or a list for fields that bind per item.",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/path" },
          { "type": "array", "items": { "$ref": "#/$defs/path" } }
        ]
      }
    },
    "textStyle": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fontFamily",
        "fontStyle",
        "fontSize",
        "lineHeight",
        "letterSpacing",
        "textCase",
        "textDecoration",
        "paragraphSpacing"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "fontFamily": { "type": "string" },
        "fontStyle": { "type": "string" },
        "fontSize": { "type": "number" },
        "lineHeight": { "$ref": "#/$defs/unitValue" },
        "letterSpacing": { "$ref": "#/$defs/unitValue" },
        "textCase": { "type": "string" },
        "textDecoration": { "type": "string" },
        "paragraphSpacing": { "type": "number" },
        "boundVariables": { "$ref": "#/$defs/bound" }
      }
    },
    "effectStyle": {
      "type": "object",
      "required": ["id", "name", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "visible"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "DROP_SHADOW",
                  "INNER_SHADOW",
                  "LAYER_BLUR",
                  "BACKGROUND_BLUR",
                  "NOISE",
                  "TEXTURE",
                  "GLASS"
                ]
              },
              "visible": { "type": "boolean" },
              "color": { "$ref": "#/$defs/hex" },
              "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
              "offset": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
              },
              "radius": { "type": "number" },
              "spread": { "type": "number" },
              "blendMode": { "type": "string" },
              "showShadowBehindNode": { "type": "boolean" },
              "boundVariables": { "$ref": "#/$defs/bound" }
            }
          }
        },
        "boundVariables": { "$ref": "#/$defs/bound" }
      }
    }
  }
}
